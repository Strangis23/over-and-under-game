; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Over and Under Game"
config/description="Swipe duel comparison guessing game (Over/Under & More or Less)"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/trophy.png"

[autoload]

AudioManager="*res://scripts/autoload/AudioManager.gd"
CategoryLoader="*res://scripts/autoload/CategoryLoader.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
WebImageLoader="*res://scripts/autoload/WebImageLoader.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.12, 1)
